# Copy to .env and fill in. Never commit .env.
DATABASE_URL=postgres://localhost:5432/lovenotes_dev
BETTER_AUTH_SECRET=replace-with-32+-random-chars
PUBLIC_API_URL=http://localhost:3000
APP_SCHEME=lovenotes
PORT=3000
# "console" logs OTP emails to stdout (dev only). "resend" requires RESEND_API_KEY.
EMAIL_TRANSPORT=console
RESEND_API_KEY=
EMAIL_FROM="Love Notes <hello@example.com>"
# Dev only: fixed 6-digit sign-in code so no email is needed. Never set in production.
DEV_FIXED_OTP=000000
# console = log pushes to stdout (dev). expo = Expo Push Service.
PUSH_TRANSPORT=console
# Dev only: /v1/dev/* simulated partner. Never in production.
DEV_TOOLS=true

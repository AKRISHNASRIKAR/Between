# Copy to .env.test. Tests TRUNCATE this database: use a dedicated disposable DB.
NODE_ENV=test
DATABASE_URL=postgres://localhost:5432/lovenotes_test
BETTER_AUTH_SECRET=local-test-only-replace-with-a-random-32-character-secret
PUBLIC_API_URL=http://localhost:3000
APP_SCHEME=lovenotes
PORT=3000
EMAIL_TRANSPORT=console
PUSH_TRANSPORT=console
STORAGE_DRIVER=local
DEV_TOOLS=true
# Leave DEV_FIXED_OTP unset: test helpers read generated codes from the console outbox.

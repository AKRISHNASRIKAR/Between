{
  "expo": {
    "name": "Love Notes",
    "slug": "lovenotes",
    "scheme": "lovenotes",
    "version": "0.1.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "backgroundColor": "#FAF6EE",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "app.lovenotes.mobile"
    },
    "android": {
      "package": "app.lovenotes.mobile",
      "adaptiveIcon": {
        "backgroundColor": "#FF7BAC",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "bundler": "metro",
      "output": "single",
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "expo-sqlite",
      "expo-image",
      "expo-font",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#FAF6EE",
          "image": "./assets/splash-icon.png",
          "imageWidth": 120
        }
      ],
      [
        "expo-build-properties",
        {
          "ios": {
            "enableSceneSupport": true
          }
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Love Notes needs your photos so you can add them to your shared journal.",
          "cameraPermission": "Love Notes uses the camera so you can snap a memory for your shared journal."
        }
      ],
      [
        "expo-notifications",
        {
          "color": "#FF7BAC",
          "sounds": ["./assets/sounds/chime.wav"],
          "icon": "./assets/android-icon-monochrome.png"
        }
      ],
      [
        "expo-widgets",
        {
          "groupIdentifier": "group.app.lovenotes.mobile",
          "widgets": [
            {
              "name": "Us",
              "displayName": "Love Notes",
              "description": "Your pet, today's vibes, and anything waiting for you.",
              "ios": {
                "supportedFamilies": ["systemSmall", "systemMedium", "accessoryRectangular", "accessoryInline"]
              }
            }
          ]
        }
      ],
      [
        "react-native-android-widget",
        {
          "widgets": [
            {
              "name": "Us",
              "label": "Love Notes",
              "description": "Your pet, today's vibes, and anything waiting for you.",
              "minWidth": "110dp",
              "minHeight": "110dp",
              "targetCellWidth": 2,
              "targetCellHeight": 2,
              "maxResizeWidth": "320dp",
              "maxResizeHeight": "180dp",
              "resizeMode": "horizontal|vertical",
              "updatePeriodMillis": 1800000
            }
          ]
        }
      ],
      "./plugins/with-workmanager-alignment.js"
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}

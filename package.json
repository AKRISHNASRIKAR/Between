{
  "name": "lovenotes",
  "private": true,
  "version": "0.0.0",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev:api": "bun --filter @lovenotes/api dev",
    "dev:mobile": "bun --filter @lovenotes/mobile start",
    "typecheck": "bun --filter '*' typecheck",
    "test": "bun --filter '*' test",
    "lint": "biome check . && bun scripts/check-design-tokens.ts",
    "format": "biome check --write ."
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.14",
    "typescript": "~6.0.3"
  }
}

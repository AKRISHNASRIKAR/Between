# Copy to deploy/.env.production on the server. Never commit the real file.
NODE_ENV=production
PORT=3000
PUBLIC_API_URL=https://api.example.com
APP_SCHEME=lovenotes
# Neon → Connection string (use the pooled one, sslmode=require)
DATABASE_URL=postgres://USER:PASSWORD@HOST/neondb?sslmode=require
# openssl rand -hex 32
BETTER_AUTH_SECRET=
# Email sign-in codes
EMAIL_TRANSPORT=resend
RESEND_API_KEY=
EMAIL_FROM="Between <hello@yourdomain.com>"
# Push through Expo
PUSH_TRANSPORT=expo
# Cloudflare R2 (S3 API) — bucket must be private
STORAGE_DRIVER=s3
S3_ENDPOINT=https://ACCOUNT_ID.r2.cloudflarestorage.com
S3_BUCKET=lovenotes-media
S3_REGION=auto
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# Must stay off in production (the API refuses to start otherwise)
DEV_TOOLS=false
